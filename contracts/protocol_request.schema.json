{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformHoldemRequestPayload",
  "description": "平台唯一现行 Holdem 请求 payload；位于完整历史信封 requests[] 或 LongRunning 增量信封 request 中。字段固定为 11 个，禁止扩展。",
  "type": "object",
  "required": ["num_players", "dealer_id", "my_id", "my_chips", "my_cards", "public_cards", "history", "hand", "max_hand", "total_win_chips", "total_win_games"],
  "additionalProperties": false,
  "properties": {
    "num_players": { "type": "integer", "const": 2 },
    "dealer_id": { "type": "integer", "enum": [0, 1] },
    "my_id": { "type": "integer", "enum": [0, 1] },
    "my_chips": { "type": "integer", "minimum": 0 },
    "my_cards": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 51 },
      "minItems": 2,
      "maxItems": 2
    },
    "public_cards": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 51 },
      "minItems": 0,
      "maxItems": 5
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round", "player_id", "action", "action_type"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer", "minimum": 0, "maximum": 3 },
          "player_id": { "type": "integer", "enum": [0, 1] },
          "action": { "type": "integer" },
          "action_type": { "type": "string", "enum": ["fold", "allin", "call", "check", "raise"] }
        }
      }
    },
    "hand": { "type": "integer", "minimum": 0, "maximum": 69 },
    "max_hand": { "type": "integer", "const": 70 },
    "total_win_chips": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "total_win_games": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
  }
}
