{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformHoldemRequestEnvelope",
  "description": "平台唯一现行 Holdem 请求信封。Traditional 每回合及 LongRunning 首回合使用完整历史；LongRunning 握手后的回合使用单 request。",
  "oneOf": [
    {
      "type": "object",
      "required": ["requests", "responses"],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "protocol_request.schema.json" }
        },
        "responses": {
          "type": "array",
          "items": { "type": "integer", "minimum": -2 }
        }
      }
    },
    {
      "type": "object",
      "required": ["request"],
      "additionalProperties": false,
      "properties": {
        "request": { "$ref": "protocol_request.schema.json" }
      }
    }
  ]
}
