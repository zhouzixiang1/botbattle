[Unit]
Description=botzone-platform web
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project/botbattle
EnvironmentFile=-%h/project/botbattle/.env
UMask=0077
# CLI loads BZ_HOST/BZ_PORT from EnvironmentFile and enforces the explicit
# BZ_ALLOW_LAN_BIND gate. Missing configuration remains loopback:50380.
ExecStart=%h/project/botbattle/.venv/bin/python -m bzplat.backend.cli serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
