[Unit]
Description=botzone-platform web
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project/botbattle
EnvironmentFile=-%h/project/botbattle/.env
UMask=0077
ExecStart=%h/project/botbattle/.venv/bin/python -m bzplat.backend.cli serve --host 127.0.0.1 --port 50380
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
