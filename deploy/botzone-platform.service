[Unit]
Description=botzone-platform web
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project/botbattle
EnvironmentFile=-%h/project/botbattle/.env
ExecStart=%h/project/botbattle/.venv/bin/python -m bzplat.backend.cli serve --host ${BZ_HOST:-0.0.0.0} --port ${BZ_PORT:-50380}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
