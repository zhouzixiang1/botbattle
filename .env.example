# botbattle 环境变量模板
# 复制为 .env 后填写；.env 勿提交

# --- Web ---
BZ_HOST=127.0.0.1
BZ_PORT=50380

# --- SMTP（邮箱验证 / 重置密码）---
# 填写你自己的 SMTP 服务；未配置时注册/重置密码接口会返回「邮件服务未配置」
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=botbattle
EMAIL_CODE_TTL_MINUTES=30

# --- 安全 / 限流 ---
# HTTPS 部署设为 1；本地 HTTP 保持 0。
BZ_SECURE_COOKIE=0
# BZ_MAX_CONCURRENT_MATCHES=2
# 信任代理头取真实客户端 IP：公网经 nginx/frp 反代暴露时必须开启（=1），
# 否则限流按 127.0.0.1 共一个桶（失效）、登录记录的 IP 不真实。
# 本地直连（无反代）开发时保持 0/不设。
BZ_TRUST_PROXY=0

# --- 路径 ---
# BZ_DB_PATH=botzone.db
# BZ_AVATAR_DIR=avatars
# BZ_LOG_DIR=logs
