# botbattle 环境变量模板
# 复制为 .env 后填写；.env 勿提交

# --- Web ---
BZ_HOST=127.0.0.1
BZ_PORT=50380
# 浏览器实际访问的唯一 origin（无路径/查询）；生产必须显式设置。
# BZ_PUBLIC_ORIGIN=https://bot.example.com

# --- 运行实例 / Docker 隔离 ---
# 生产必须显式设置稳定且唯一的实例名；每个 worktree 使用不同名称。
# BZ_INSTANCE_KEY=prod-main
# 只支持本机 canonical Docker socket；平台不接受远端 Docker 控制面。
BZ_DOCKER_HOST=unix:///var/run/docker.sock
# BZ_QA_INSTANCE、BZ_TEST_CAPTCHA、BZ_SKIP_CAPTCHA 仅限隔离测试，生产不得启用。

# --- SMTP（邮箱验证 / 重置密码）---
# 填写你自己的 SMTP 服务；未配置时注册/重置密码接口会返回「邮件服务未配置」
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Botbattle
EMAIL_CODE_TTL_MINUTES=30

# --- 安全 / 限流 ---
# HTTPS 部署设为 1；本地 HTTP 保持 0。
BZ_SECURE_COOKIE=0
# 由应用添加 HSTS 时设为 1；若 nginx 已统一添加则避免重复配置。
BZ_HSTS=0
# 信任代理头取真实客户端 IP：公网经 nginx/frp 反代暴露时必须开启（=1），
# 否则限流按 127.0.0.1 共一个桶（失效）、登录记录的 IP 不真实。
# 本地直连（无反代）开发时保持 0/不设。
BZ_TRUST_PROXY=0
# 当前 nginx 是唯一写入 HTTP 转发头的代理；frp 为 TCP 透传，不计一跳。
BZ_TRUSTED_PROXY_HOPS=1

# --- 路径 ---
# BZ_DB_PATH=botzone.db
# BZ_AVATAR_DIR=avatars
# BZ_LOG_DIR=logs
