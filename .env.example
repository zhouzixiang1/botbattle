# botbattle 环境变量模板
# 复制为 .env 后填写；.env 勿提交

# --- Web ---
BZ_HOST=127.0.0.1
BZ_PORT=50380

# --- SMTP（邮箱验证 / 重置密码）---
# 填写你自己的 SMTP 服务；未配置时注册/重置密码接口会返回「邮件服务未配置」
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=botbattle
EMAIL_CODE_TTL_MINUTES=30

# --- 安全 / 限流 ---
# BZ_COOKIE_SECURE=0
# BZ_MAX_CONCURRENT_MATCHES=2

# --- 路径 ---
# BZ_DB_PATH=botzone.db
# BZ_UPLOAD_ROOT=bot_uploads
